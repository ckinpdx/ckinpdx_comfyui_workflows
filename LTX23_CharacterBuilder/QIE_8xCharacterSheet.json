      "properties": {
        "cnr_id": "comfyui-ollama",
        "ver": "6db7560576e5a59488708e6be13e07b5aba2432a",
        "Node name for S&R": "OllamaGenerateV2",
        "ue_properties": {
          "widget_ue_connectable": {},
